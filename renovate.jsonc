{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate-base.jsonc"],
  "description": "Preset for use with WillBooster and WillBoosterLab repos",
  // The token is a Mend organization secret that exists only in the WillBooster and WillBoosterLab
  // organizations, and hostRules from a preset cannot be removed by the extending repository, so
  // repositories in other organizations must extend renovate-base.jsonc instead.
  "hostRules": [
    {
      "hostType": "npm",
      "matchHost": "https://verdaccio-production-e389.up.railway.app/",
      "token": "{{ secrets.VerdaccioReadonlyToken }}",
    },
  ],
  "npmrc": "@willbooster-private:registry=https://verdaccio-production-e389.up.railway.app/",
  "npmrcMerge": true,
}
