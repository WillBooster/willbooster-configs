{
  "name": "@willbooster/configs",
  "version": "0.0.0-semantically-released",
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/willbooster-configs.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "bun wb release",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@anolilab/multi-semantic-release": "4.4.25",
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@willbooster/wb": "22.29.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "semantic-release": "25.0.9"
  },
  "prettier": "./packages/prettier-config/.prettierrc.json"
}
